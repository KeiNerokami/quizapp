        android:fillColor="#4460519b"
        android:pathData="
            M1,0.3
            C0.8,0.25 0.2,0.7 0,0.65
            L0,0
            L1,0
            Z"/>

    <!-- Drop shadow (curved, offset) -->
    <path
        android:fillColor="#431e202c"
        android:pathData="
            M1,0.33
            C0.78,0.28 0.18,0.73 0,0.68
            L0,0
            L1,0
            Z"/>

    <!-- Inverted curved reflection at bottom -->
    <path
        android:fillColor="#4460519b"
        android:pathData="
            M0,0.65
            C0.2,0.7 0.8,0.25 1,0.3
            L1,1
            L0,1
            Z"/>
</vector>
